# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefactos de compilacion que se pueden colar fuera de target/.
# `git add .` no debe poder meter un binario de 24 MB en el repo.
/*.exe
/src-tauri/*.exe
*.pdb
*.ilk
*.lib
*.a
*.rlib

# Runtime de whisper.cpp: ~12 MB de binarios de terceros que se despliegan con
# scripts\deploy-whisper.ps1. Se ignoran aqui, no en src-tauri/.gitignore, para que
# la regla sea visible desde la raiz junto a la de node_modules.
/src-tauri/crates/lyricstream-whisper-sys/runtime/

# El WAV de muestra y el modelo tambien viven ahi dentro, pero por si acaso.
/src-tauri/crates/lyricstream-whisper-sys/**/*.dll
/src-tauri/crates/lyricstream-whisper-sys/**/*.wav
